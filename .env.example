# Sample environment file.
# Copy this file to ".env" and change the values. Never commit ".env".
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server and are never sent to the browser.
# Variables WITH NEXT_PUBLIC_ are built into the JavaScript the browser downloads, so they must
# never hold secrets.

# ---- Backend services -----------------------------------------------------
# Where the SportsAura user service runs (login, registration, profiles).
# Locally: http://localhost:8081   Inside docker compose: http://host.docker.internal:8081
USER_SERVICE_URL=http://localhost:8081
# Where the SportsAura trainer service runs (sports, trainers, page text).
# Locally: http://localhost:8082   Inside docker compose: http://host.docker.internal:8082
TRAINER_SERVICE_URL=http://localhost:8082
